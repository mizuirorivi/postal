{
  "name": "Outbox Retry and ACK Context",
  "description": "Participant metadata for persistent outbox records, retries, and reply_to acknowledgement.",
  "nodes": {
    "participant-A": {
      "name": "Sender AI",
      "data": {
        "Role": { "type": "Text Input", "value": "Calls postal_send" }
      }
    },
    "participant-T": {
      "name": "postal_send Tool",
      "data": {
        "Functions": { "type": "Text Input", "value": "dispatchLetter, attemptOutbox, signLetter, markOutboxAcked" }
      }
    },
    "participant-K": {
      "name": "Outbox KV",
      "data": {
        "Keys": { "type": "Text Input", "value": "outbox/index, outbox/<msgID>" }
      }
    },
    "participant-R": {
      "name": "Retry Scanner",
      "data": {
        "Schedule": { "type": "Text Input", "value": "setInterval every 15 seconds" }
      }
    },
    "participant-B": {
      "name": "Peer Session",
      "data": {
        "Role": { "type": "Text Input", "value": "Receives the letter and replies with reply_to" }
      }
    }
  }
}
